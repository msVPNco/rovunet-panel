{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msVPNco/rovunet-panel/contracts/subscription-v1",
  "title": "Existing Rovunet subscription envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "name": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "link"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
          "link": {"type": "string"}
        }
      }
    }
  },
  "$comment": "Item IDs must also be unique; parsed nesting <=16; reader-specific byte/native-envelope limits remain. No capability fields are added to this feed. Numeric serialization is literal 1; a JSON Schema validator alone is not the client parser."
}
